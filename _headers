# Cloudflare Pages _headers file
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Screenshots: never cache. Means whenever we re-shoot, the new
# version shows up on the next visit, no hard-refresh needed.
/screenshots/*
  Cache-Control: no-cache, must-revalidate

# HTML always revalidates already (Cloudflare default), but be explicit.
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Mission Control — internal ops dashboard. Never cache (it must show the
# current picture during an incident, not a CDN copy of ten minutes ago), and
# never index. The data itself is owner-gated server-side; these headers just
# stop the shell turning up in a search result.
/ops
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

/ops.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
